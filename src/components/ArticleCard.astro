---
import type { Article } from '../lib/demo';
import { withBasePath } from '../lib/paths';

interface Props {
  article: Article;
}

const { article } = Astro.props as Props;
---

<article
  data-article-card
  data-search={`${article.title} ${article.excerpt} ${article.author}`.toLowerCase()}
  class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md"
>
  <a href={withBasePath(`/articulos/${article.slug}`)} class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-700 focus-visible:ring-offset-2">
    <img src={article.image} alt={article.title} class="h-56 w-full object-cover" loading="lazy" />
    <div class="space-y-4 p-5">
      <div class="flex items-center justify-between gap-2 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-sky-800">
        <span>{article.type}</span>
        <span>{article.categoryName ?? article.category}</span>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-slate-900 group-hover:text-sky-900">{article.title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600">{article.excerpt}</p>
      </div>
      <div class="flex items-center justify-between text-xs text-slate-500">
        <span>{article.author}</span>
        <span>{article.publishedAt}</span>
      </div>
    </div>
  </a>
</article>
