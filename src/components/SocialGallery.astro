---
import type { SocialPost } from '../lib/demo';

interface Props {
  posts: SocialPost[];
}

const { posts } = Astro.props as Props;
---

<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  {posts.map((post) => (
    <a href={post.href} target="_blank" rel="noreferrer" class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md">
      <img src={post.image} alt={post.alt} class="h-64 w-full object-cover" loading="lazy" />
      <div class="space-y-2 p-4">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-sky-800">{post.platform}</p>
        <h3 class="text-lg font-semibold text-slate-900">{post.title}</h3>
        <p class="text-sm leading-6 text-slate-600">{post.description}</p>
      </div>
    </a>
  ))}
</div>
