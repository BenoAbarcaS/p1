---
import Layout from '../layouts/Layout.astro';
import { featuredVideo, getYouTubeThumbnail, getYouTubeVideoId, getYouTubeVideoUrl, videos } from '../lib/demo';

const otherVideos = videos.filter((video) => video.slug !== featuredVideo.slug);
const featuredVideoId = getYouTubeVideoId(featuredVideo);
---

<Layout title="Vídeos" description="Contenido audiovisual de la revista con reportajes, entrevistas y documentales breves." >
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <section class="space-y-4">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-800">Vídeos</p>
      <h1 class="text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Narrativas en movimiento</h1>
    </section>

    <section class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-3 shadow-sm">
      <div class="aspect-video overflow-hidden rounded-[1.5rem] bg-slate-950">
        <iframe
          class="h-full w-full"
          src={featuredVideoId ? `https://www.youtube.com/embed/${featuredVideoId}` : undefined}
          title={featuredVideo.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
      <div class="space-y-3 p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sky-800">Vídeo destacado</p>
        <h2 class="text-3xl font-bold text-slate-950">{featuredVideo.title}</h2>
        <p class="text-base leading-7 text-slate-600">{featuredVideo.description}</p>
      </div>
    </section>

    <section class="mt-12">
      <div class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-800">Últimos vídeos</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Selección reciente</h2>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {otherVideos.map((video) => (
          <a href={getYouTubeVideoUrl(video)} target="_blank" rel="noreferrer" class="group block overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <img src={getYouTubeThumbnail(video)} alt={video.title} class="h-52 w-full object-cover" />
            <div class="space-y-3 p-5">
              <div class="flex items-center justify-between text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-sky-800">
                <span>Vídeo</span>
                <span>{video.duration}</span>
              </div>
              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-sky-900">{video.title}</h3>
              <p class="text-sm leading-6 text-slate-600">{video.description}</p>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span>{video.publishedAt}</span>
                <span class="font-medium text-sky-900">Ver en YouTube</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
