---
import Layout from '../layouts/Layout.astro';
import { withBasePath } from '../lib/paths';
---

<Layout title="Página no encontrada" description="La página que buscas no existe o ha sido movida.">
  <main class="mx-auto flex min-h-[60vh] max-w-4xl items-center justify-center px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-[2rem] border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-800">Error 404</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">No encontramos esta página</h1>
      <p class="mt-4 text-lg text-slate-600">La dirección solicitada no está disponible en este momento.</p>
      <a href={withBasePath('/')} class="mt-8 inline-flex rounded-full bg-sky-950 px-5 py-3 text-sm font-semibold text-white hover:bg-sky-900">Volver al inicio</a>
    </div>
  </main>
</Layout>
