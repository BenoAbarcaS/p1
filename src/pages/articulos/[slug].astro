---
import Layout from '../../layouts/Layout.astro';
import { toHTML } from '@portabletext/to-html';
import { authors, categories } from '../../lib/demo';
import type { Article } from '../../lib/demo';
import { getArticles } from '../../lib/queries';
import { withBasePath } from '../../lib/paths';

interface Props {
  article: Article;
  relatedArticles: Article[];
}

export async function getStaticPaths() {
  const articles = await getArticles();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, relatedArticles: articles.filter((item) => item.slug !== article.slug).slice(0, 3) },
  }));
}

const { article, relatedArticles } = Astro.props as Props;
const author = authors.find((person) => person.slug === article.authorSlug) ?? {
  name: article.author,
  slug: article.authorSlug,
};
const hasAuthorProfile = authors.some((person) => person.slug === article.authorSlug);
const category = categories.find((item) => item.slug === article.category) ?? {
  name: article.categoryName ?? article.category,
  slug: article.category,
};
const bodyHtml = article.body?.length
  ? toHTML(article.body as never, {
      components: {
        types: {
          image: ({ value }) => {
            const src = value.asset?.url;
            if (!src) return '';
            const alt = String(value.alt ?? '').replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
            return `<figure><img src="${src}" alt="${alt}" /></figure>`;
          },
          table: ({ value }) => {
            const escapeHtml = (text: unknown) =>
              String(text ?? '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#39;');
            const headers: unknown[] = Array.isArray(value.headers) ? value.headers : [];
            const rows: { cells?: unknown[] }[] = Array.isArray(value.rows) ? value.rows : [];
            const headerHtml = headers.map((header) => `<th scope="col">${escapeHtml(header)}</th>`).join('');
            const rowsHtml = rows
              .map((row) => {
                const cells: unknown[] = Array.isArray(row.cells) ? row.cells : [];
                return `<tr>${cells.map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}</tr>`;
              })
              .join('');

            return `<div class="article-table-wrap"><table><thead><tr>${headerHtml}</tr></thead><tbody>${rowsHtml}</tbody></table></div>`;
          },
        },
      },
    })
  : '<p>Este texto todavía no tiene contenido publicado.</p>';
---

<Layout title={article.title} description={article.excerpt}>
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <article>
      <header class="mx-auto max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-800">{category.name}</p>
        <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">{article.title}</h1>
        <p class="mt-4 text-xl leading-8 text-slate-600">{article.subtitle}</p>

        <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-slate-600">
          <span>Por {hasAuthorProfile ? <a href={withBasePath(`/nosotros#${author.slug}`)} class="font-semibold text-sky-900">{author.name}</a> : <span class="font-semibold text-slate-700">{author.name}</span>}</span>
          <span>•</span>
          <span>{article.publishedAt}</span>
          <span>•</span>
          <span>{article.readingTime}</span>
        </div>
      </header>

      <div class="mt-10 overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-3 shadow-sm">
        <img src={article.image} alt={article.title} class="h-[520px] w-full rounded-[1.5rem] object-cover" />
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-10 lg:grid-cols-[1fr_280px]">
        <div class="editorial-copy" set:html={bodyHtml}></div>

        <aside class="space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">Detalles</h2>
            <ul class="mt-4 space-y-3 text-sm text-slate-600">
              <li><span class="font-medium text-slate-900">Autor:</span> {author.name}</li>
              <li><span class="font-medium text-slate-900">Categoría:</span> {category.name}</li>
              <li><span class="font-medium text-slate-900">Tiempo de lectura:</span> {article.readingTime}</li>
              <li><span class="font-medium text-slate-900">Fecha:</span> {article.publishedAt}</li>
            </ul>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-semibold text-slate-900">Compartir</h2>
            <div class="mt-4 flex gap-3 text-sm font-medium text-sky-900">
              <a href="#" class="rounded-full border border-slate-200 px-3 py-2">X</a>
              <a href="#" class="rounded-full border border-slate-200 px-3 py-2">LinkedIn</a>
              <a href="#" class="rounded-full border border-slate-200 px-3 py-2">Correo</a>
            </div>
          </div>
        </aside>
      </div>
    </article>

    <section class="mx-auto mt-16 max-w-5xl">
      <h2 class="text-3xl font-bold tracking-tight text-slate-950">Artículos relacionados</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {relatedArticles.map((item) => (
          <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <img src={item.image} alt={item.title} class="h-44 w-full object-cover" />
            <div class="space-y-3 p-4">
              <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-sky-800">{item.type}</p>
              <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
              <a href={withBasePath(`/articulos/${item.slug}`)} class="text-sm font-semibold text-sky-900 hover:underline">Leer más</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
