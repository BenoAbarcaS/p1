---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories } from '../../lib/demo';
import type { Article } from '../../lib/demo';
import { getArticles } from '../../lib/queries';
import { withBasePath } from '../../lib/paths';

const selectedCategory = Astro.url.searchParams.get('categoria') ?? 'all';
const searchTerm = Astro.url.searchParams.get('q') ?? '';
const articles: Article[] = await getArticles();

const filteredArticles = articles.filter((article) => selectedCategory === 'all' || article.category === selectedCategory);
---

<Layout title="Artículos" description="Archivo de artículos, ensayos y reportajes de la revista." >
  <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <section class="space-y-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-800">Archivos</p>
        <h1 class="mt-2 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Artículos y reportajes</h1>
      </div>

      <form id="article-search-form" method="get" class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm md:grid-cols-[1fr_auto]">
        <label class="flex items-center gap-3 rounded-full border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
          <span aria-hidden="true">⌕</span>
          <input
            id="article-search-input"
            type="search"
            name="q"
            value={searchTerm}
            placeholder="Buscar artículos o autores"
            class="w-full bg-transparent text-slate-800 outline-none placeholder:text-slate-400"
          />
        </label>
        <button type="submit" class="rounded-full bg-sky-950 px-5 py-3 text-sm font-semibold text-white hover:bg-sky-900">
          Buscar
        </button>
      </form>

      <div class="flex flex-wrap gap-3">
        <a href={withBasePath('/articulos')} class:list={['rounded-full px-4 py-2 text-sm font-medium transition', selectedCategory === 'all' ? 'bg-sky-950 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:border-sky-700 hover:text-sky-900']}>
          Todas
        </a>
        {categories.map((category) => (
          <a
            href={withBasePath(`/articulos?categoria=${category.slug}`)}
            class:list={['rounded-full px-4 py-2 text-sm font-medium transition', selectedCategory === category.slug ? 'bg-sky-950 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:border-sky-700 hover:text-sky-900']}
          >
            {category.name}
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {filteredArticles.map((article) => <ArticleCard article={article} />)}
      </div>
      <div id="article-no-results" hidden class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <h2 class="text-2xl font-bold text-slate-900">No hay resultados para esta búsqueda.</h2>
        <p class="mt-3 text-slate-600">Prueba otra categoría o un término distinto.</p>
      </div>
    </section>
  </main>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#article-search-form');
  const input = document.querySelector<HTMLInputElement>('#article-search-input');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article-card]'));
  const noResults = document.querySelector<HTMLElement>('#article-no-results');

  function applySearch(updateUrl = true) {
    const term = input?.value.trim().toLocaleLowerCase() ?? '';
    let visibleCount = 0;

    for (const card of cards) {
      const matches = !term || (card.dataset.search ?? '').includes(term);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    if (noResults) noResults.hidden = visibleCount > 0;

    if (updateUrl && input) {
      const url = new URL(window.location.href);
      if (input.value.trim()) url.searchParams.set('q', input.value.trim());
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }
  }

  if (form && input) {
    input.value = new URLSearchParams(window.location.search).get('q') ?? input.value;
    applySearch(false);
    input.addEventListener('input', () => applySearch());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applySearch();
    });
  }
</script>
